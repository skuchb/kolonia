{
  "name": "kolonia-design-mock",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build:app": "vinext build",
    "build": "npm run seed:content && npm run build:app && node tools/post-deploy-seed.mjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "build:data": "node tools/build-data.mjs",
    "generate:pwa-icons": "node tools/generate-pwa-icons.mjs",
    "seed:content": "node tools/seed-content.mjs",
    "seed:d1": "node tools/seed-d1.mjs",
    "seed:d1:remote": "node tools/seed-d1.mjs --remote",
    "d1:create": "wrangler d1 create kolonia-db",
    "d1:migrate:remote": "node tools/post-deploy-migrate.mjs --remote",
    "d1:migrate:local": "node tools/post-deploy-migrate.mjs --local"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
